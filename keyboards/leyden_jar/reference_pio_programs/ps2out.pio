.program ps2out
.side_set 1 opt pindirs

// HEADS UP: one instruction below is NOT what runs on hardware.
//
// Offset 4, `wait 1 pin, 1`, is OVERWRITTEN at init by ps2_platform_init
// (ps2_platform_pico.c / ps2_platform_chibios.c) with an absolute-GPIO wait:
//
//     wait 1 pin, 1   ->   wait 1 gpio, <clock_pin>      (0x2080 | clock_pin)
//
// Why: `pin, N` is relative to the state machine's IN base, and
// sm_config_set_in_pins puts that base on DATA. So as assembled, `pin, 1`
// means data+1 - the program silently assumes clock == data+1. That holds
// for upstream ps2x2pico, but not here: this project wires clock=GP28,
// data=GP29, so clock is data MINUS one and the unpatched instruction would
// wait on GP30 forever. Patching to an absolute GPIO lets any two pins work.
// (QMK's own PIO PS/2 host driver takes the other route and just refuses to
// build unless clock == data+1.)
//
// Consequences if you edit this program:
//   - Keep that wait at offset 4, or update the index in BOTH platform files.
//     The patch is a bare `instr_mem[offset + 4] = ...` with no assertion, so
//     inserting an instruction above it silently corrupts a different one.
//   - The committed ps2out.pio.h must be regenerated to match this file.
//   - All 32 instruction slots are in use (see .length = 32 in ps2out.pio.h),
//     so nothing can be added here without removing something first.

restart:
  set    pindirs, 0             [1] // set clock to input mode
  irq    clear 0 rel     side 0     // clear busy flag, set data to input mode

receivecheck:
  jmp    pin, sendcheck             // if clock is high, see if we have data to send
  irq    nowait 0 rel               // clock is being pulled low, set busy flag
  wait   1 pin, 1                   // wait for clock high - PATCHED at init to
                                    // `wait 1 gpio, <clock>`; see HEADS UP above

  // we are not sending, look for a start bit (clock high, data low)
  in     pins, 1                    // read in from data
  mov    x, isr                     // move what we read to x
  mov    isr, null                  // clear ISR
  jmp    !x, receive                // if x is low, start the receive process
  jmp    restart                    // not receiving

receive:
  set    x, 8                   [7] // set loop counter
  set    pindirs, 1             [7] // clock low

receiveloop:
  set    pindirs, 0             [7] // clock high
  in     pins, 1                [6] // read a bit into ISR
  set    pindirs, 1             [6] // clock low
  jmp    x--, receiveloop       [6] // iterate
  set    pindirs, 0             [7] // clock high
  nop                    side 1 [6] // data low
  set    pindirs, 1             [7] // clock low
  jmp    restart                [5]

sendcheck:
  jmp    !osre, send                // see if we have data to send
  jmp    receivecheck               // no data to send, restart

send:
  irq    nowait 0 rel               // set busy flag
  set    x, 10                      // number of bits to write out

sendloop:
  set    pindirs, 0             [5] // clock set to input (high)
  jmp    pin, sendcontinue          // if clock is high, host is still receiving data
  out    null, 32                   // clock was low, clear OSR
  irq    wait 4 rel                 // host wants to send data, notify of failure to send data
  jmp    restart                    // and wait for restart

sendcontinue:
  out    pindirs, 1             [5] // write out data
  set    pindirs, 1             [5] // set clock low
  jmp    x--, sendloop          [5]

% c-sdk {
  void ps2out_program_init(PIO pio, uint sm, uint offset, uint dat, uint clk) {
    pio_sm_config c = ps2out_program_get_default_config(offset);
    
    pio_gpio_init(pio, clk);
    pio_gpio_init(pio, dat);
    
    // Use a frequency high enough to effectivly sample clock and data.
    sm_config_set_clkdiv(&c, 320); // 2.5 µs
    sm_config_set_jmp_pin(&c, clk);
    sm_config_set_set_pins(&c, clk, 1);
    sm_config_set_sideset_pins(&c, dat);
    sm_config_set_out_pins(&c, dat, 1);
    sm_config_set_out_shift(&c, true, true, 11);
    sm_config_set_in_pins(&c, dat);
    sm_config_set_in_shift(&c, true, true, 9);
    
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
  }
%}
